    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "volta": {
    "node": "24.14.1"
  }
