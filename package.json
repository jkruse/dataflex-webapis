  "scripts": {
    "watch": "vite build --watch",
    "build": "eslint src && vite build",
    "copy-server-props": "copyfiles -f \"%ProgramFiles%/DataFlex 26.0/Lib/WebAppMaster/Data/[Ww]eb[Aa]pp[Ss]erver[Pp]rops.*\" Data",
    "zip-demo": "7z a dist/WebAPIsDemo.zip * -r -x!.git -x!.github -x!.idea -x!.vscode -x!CssThemes -x!WebUI -x!DfPkg -x!dist -x!IdeSrc/* -x!node_modules -x!temp -x!WebAPIs-*.zip -x!*.dep -x!*.prn -x!*.dbg -x!*.exe -x!*.log"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
